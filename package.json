{
  "name": "masa-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run tests && vitest run src/yoyo",
    "test:physics": "vitest run tests/physics.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "assets:prepare": "tsx scripts/assets.ts prepare",
    "assets:verify": "tsx scripts/assets.ts verify",
    "verify": "tsx scripts/verify.ts",
    "test:stability": "tsx scripts/stress.ts",
    "test:audio": "tsx scripts/audio-qa.ts",
    "audit:dist": "tsx scripts/audit-dist.ts",
    "test:topology": "tsx scripts/fold-topology.ts",
    "test:yoyo": "vitest run src/yoyo",
    "test:yoyo:replays": "tsx scripts/yoyo-replays.ts",
    "test:yoyo:scenarios": "tsx scripts/yoyo-scenarios.ts",
    "test:yoyo:audio": "tsx scripts/yoyo-audio-qa.ts",
    "benchmark:yoyo": "tsx scripts/yoyo-benchmark.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.56.0",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/three": "0.180.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@12.6.0"
}
